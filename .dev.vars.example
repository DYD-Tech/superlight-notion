# Copy to .dev.vars for local development. Do not commit .dev.vars.

# Recommended: Notion OAuth (public connection)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8788/api/oauth/callback
SESSION_SECRET=

# Optional dev fallback, used only when the OAuth variables above are absent
# NOTION_TOKEN=secret_xxxxxxxx
# NOTION_ROOT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APP_PASSWORD=change-me
