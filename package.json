{
  "name": "superlight-notion",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Lightweight reader and light editor for private Notion text notes.",
  "scripts": {
    "dev": "wrangler pages dev -- vite",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "wrangler pages dev dist",
    "typecheck": "tsc -b --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "notion-compat": "8.0.8",
    "notion-types": "8.0.8",
    "notion-utils": "8.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-notion-x": "8.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.34.6"
}
